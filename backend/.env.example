# Optional. Raises GitHub rate limit from 60 to 5000 req/hour. Keep it backend-only.
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: enables AI analysis. Get a key at console.anthropic.com. Backend-only, never commit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: Google Gemini AI analysis (backend-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
